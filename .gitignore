# ==========================================
# CreditSetu Global .gitignore
# ==========================================

# Dependencies
node_modules/
*/node_modules/
package-lock.json.bak

# Build Artifacts & Binaries
dist/
*/dist/
build/
*/build/
out/
*/out/
target/
*/target/
*.jar
*.war
*.class

# Python Virtual Environments & Cache
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
*/venv/
ENV/
.pytest_cache/
*.egg-info/
.coverage
htmlcov/

# Local Database Files & Runtime State
data/
*/data/
*.mv.db
*.trace.db
*.lock.db
*.sqlite3

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.local

# IDE & Editor Configurations
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
*.bak
*.tmp

# Runtime Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
