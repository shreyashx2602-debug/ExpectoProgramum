# CredExplain Environment Configuration Example
# Copy to .env for custom deployments

# Core Backend Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=default
H2_CONSOLE_ENABLED=true

# PostgreSQL Production Database (Optional)
POSTGRES_DB=credexplain
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Python Analytics & Machine Learning Service
ML_SERVICE_PORT=8000
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_URL=http://localhost:8000

# React Client Frontend
VITE_CORE_API_URL=http://localhost:8080/api
VITE_ML_API_URL=http://localhost:8000/api/ml
